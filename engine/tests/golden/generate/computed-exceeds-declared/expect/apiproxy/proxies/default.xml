<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <PreFlow>
    <Request>
      <Step>
        <Name>JS-StripCtierNamespace</Name>
      </Step>
      <Step>
        <Name>SC-StripCtierHeaders</Name>
      </Step>
      <Step>
        <Name>AM-DefaultTier</Name>
      </Step>
      <Step>
        <Name>AM-Deployment</Name>
      </Step>
    </Request>
  </PreFlow>
  <Flows>
    <Flow name="getRecord">
      <Condition>(proxy.pathsuffix MatchesPath "/records/*") and (request.verb = "GET")</Condition>
      <Request>
        <Step>
          <Name>AM-Tier-getRecord</Name>
        </Step>
      </Request>
    </Flow>
  </Flows>
  <PostFlow>
    <Request>
      <Step>
        <Name>RF-Provisioning</Name>
        <Condition>(ctier.excluded = "true") or (ctier.tier = "3")</Condition>
      </Step>
      <Step>
        <Name>RF-Tier4</Name>
        <Condition>ctier.tier = "4"</Condition>
      </Step>
    </Request>
  </PostFlow>
  <HTTPProxyConnection>
    <BasePath>/</BasePath>
    <VirtualHost>default</VirtualHost>
  </HTTPProxyConnection>
  <RouteRule name="default">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
