<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ServiceCallout name="SC-RecordDecision" continueOnError="true">
  <DisplayName>SC-RecordDecision</DisplayName>
  <Request clearPayload="true">
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <Set>
      <Verb>POST</Verb>
      <Path>/v1/ledger</Path>
      <Headers>
        <Header name="Content-Type">application/json</Header>
      </Headers>
      <Payload contentType="application/json">{ctier.record.json}</Payload>
    </Set>
  </Request>
  <Response>ctierRecord</Response>
  <HTTPTargetConnection>
    <URL>https://records.example.invalid</URL>
    <Properties>
      <Property name="io.timeout.millis">200</Property>
      <Property name="success.codes">1xx,2xx,3xx,4xx,5xx</Property>
    </Properties>
  </HTTPTargetConnection>
</ServiceCallout>
