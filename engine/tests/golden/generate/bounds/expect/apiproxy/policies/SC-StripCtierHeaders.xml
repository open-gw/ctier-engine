<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage name="SC-StripCtierHeaders">
  <!-- 1.5.0: aliases a prefix strip misses. The namespace is
       stripped by JS-StripCtierNamespace, not this closed list. -->
  <DisplayName>SC-StripCtierHeaders</DisplayName>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <Remove>
    <Headers>
        <Header name="X-Correlation-Id"/>
        <Header name="Idempotency-Key"/>
        <Header name="X-Idempotency-Key"/>
    </Headers>
  </Remove>
</AssignMessage>
